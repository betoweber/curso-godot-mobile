[gd_scene format=3]

[ext_resource type="Script" path="res://main.gd" id="1"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Fundo" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.12, 0.16, 1)

[node name="Margem" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Coluna" type="VBoxContainer" parent="Margem"]
layout_mode = 2

[node name="Botoes" type="HBoxContainer" parent="Margem/Coluna"]
layout_mode = 2

[node name="Verificar" type="Button" parent="Margem/Coluna/Botoes"]
layout_mode = 2
text = "Verificar meus exercícios (F5 de novo após editar)"

[node name="VerSolucoes" type="CheckBox" parent="Margem/Coluna/Botoes"]
layout_mode = 2
text = "Verificar as soluções (gabarito)"

[node name="Resultado" type="RichTextLabel" parent="Margem/Coluna"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = false

[connection signal="pressed" from="Margem/Coluna/Botoes/Verificar" to="." method="_on_verificar_pressed"]
